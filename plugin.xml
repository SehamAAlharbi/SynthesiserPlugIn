<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

	
	<extension point="org.eclipse.ui.commands">
		<category id="SynthesiserPlugIn.commands.category" name="Synthesiser"></category>
		<!-- first command -->
		<command categoryId="SynthesiserPlugIn.commands.category" name="Synthesis Code" id="SynthesiserPlugIn.commands.sampleCommand"></command>
		<!-- second command -->
		<command categoryId="SynthesiserPlugIn.commands.deadCode" name="Detect and Generate" id="SynthesiserPlugIn.commands.deadCode"></command>
	</extension>
	<extension point="org.eclipse.ui.handlers">
		<!-- first handler -->
		<handler class="synthesiserplugin.handlers.Handler" commandId="SynthesiserPlugIn.commands.sampleCommand"></handler>
		<!-- second handler -->
		<handler class="synthesiserplugin.handlers.DeadCodeHandler" commandId="SynthesiserPlugIn.commands.deadCode"></handler>
	</extension>
	<extension point="org.eclipse.ui.bindings">
		<!-- first key -->
		<key commandId="SynthesiserPlugIn.commands.sampleCommand" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration" contextId="org.eclipse.ui.contexts.window" sequence="M1+6"></key>
		<!-- second key -->
		<key commandId="SynthesiserPlugIn.commands.deadCode" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration" contextId="org.eclipse.ui.contexts.window" sequence="M1+7"></key>
	</extension>
	
	
	
	<extension point="org.eclipse.ui.menus">
	<!-- first menu contribution -->
		<menuContribution allPopups="false" locationURI="popup:org.eclipse.ui.popup.any">
			<command commandId="SynthesiserPlugIn.commands.sampleCommand" id="SynthesiserPlugIn.menus.sampleCommand" mnemonic="M"
				style="push">
				<visibleWhen>
					<with variable="activeMenuSelection">
						<iterate ifEmpty="false">
							<adapt type="org.eclipse.core.resources.IResource">
								<test property="org.eclipse.core.resources.name" value="*.java" />
							</adapt>
						</iterate>
					</with>
				</visibleWhen>
			</command>
		</menuContribution>
		<!-- first menu contribution -->
		
		<!-- second menu contribution -->
		<menuContribution allPopups="false" locationURI="popup:org.eclipse.ui.popup.any">
			<command commandId="SynthesiserPlugIn.commands.deadCode" id="SynthesiserPlugIn.commands.deadCode" mnemonic="m"
				style="push">
				<visibleWhen>
					<with variable="activeMenuSelection">
						<iterate ifEmpty="false">
							<adapt type="org.eclipse.core.resources.IResource">
								<test property="org.eclipse.core.resources.name" value="*.java" />
							</adapt>
						</iterate>
					</with>
				</visibleWhen>
			</command>
		</menuContribution>
	<!-- second menu contribution -->
	</extension>
	
	
	

</plugin>
